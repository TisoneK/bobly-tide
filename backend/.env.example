# Bobly Tide backend — environment template. Copy to .env and fill in.
# NEVER commit real secrets. .env is gitignored; production secrets belong in
# the deploy platform's secret store and in .context_ledger/memory/secrets/.

DATABASE_URL=postgres://user:pass@localhost:5432/bobly
PORT=3000

# Scheduler: how often to check, and the wall-clock length of one "hour".
TICK_MS=60000
HOUR_MS=3600000

# Withdrawal minimum, whole shillings (product spec §7 placeholder).
MPESA_WITHDRAWAL_MIN=50

# M-Pesa Daraja. If DARAJA_CONSUMER_KEY is empty the backend uses a fake
# client (no real calls). Fill these for the sandbox / production.
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_STK_CALLBACK_URL=
DARAJA_B2C_SHORTCODE=
DARAJA_INITIATOR_NAME=
DARAJA_SECURITY_CREDENTIAL=
DARAJA_B2C_RESULT_URL=
DARAJA_B2C_TIMEOUT_URL=
