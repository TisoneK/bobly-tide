# Bobly Tide backend — environment template. Copy to .env and fill in.
# NEVER commit real secrets. .env is gitignored; production secrets belong in
# the deploy platform's secret store and in .context_ledger/memory/secrets/.

DATABASE_URL=postgres://user:pass@localhost:5432/bobly
PORT=3000

# Scheduler: how often to check, the wall-clock length of one "hour", and how
# long a filling group may stall (members who never secure) before it is
# dissolved and everyone refunded.
TICK_MS=60000
HOUR_MS=3600000
FILL_TIMEOUT_MS=172800000

# Ops/admin phones (comma-separated, canonical 2547…). These accounts can
# review KYC submissions via /admin.
ADMIN_PHONES=

# Withdrawal minimum, whole shillings (product spec §7 placeholder).
MPESA_WITHDRAWAL_MIN=50

# Auth: JWT signing secret (REQUIRED in production — set a long random value;
# if unset the server generates an ephemeral one and tokens reset on restart)
# and OTP/session lifetimes.
AUTH_JWT_SECRET=
AUTH_OTP_TTL_SEC=300
AUTH_TOKEN_TTL_SEC=86400
AUTH_OTP_MAX_ATTEMPTS=5

# Verification / KYC. Items required before a member can join groups or move
# money. id/face/address go to a KYC provider — none is wired yet, so they
# stay pending unless KYC_AUTO_APPROVE=true (demo only; never in production).
VERIFICATION_REQUIRED=email,id,face,address
VERIFICATION_EMAIL_TTL_SEC=600
VERIFICATION_MAX_ATTEMPTS=5
KYC_AUTO_APPROVE=false

# M-Pesa Daraja. If DARAJA_CONSUMER_KEY is empty the backend uses a fake
# client (no real calls). Fill these for the sandbox / production.
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_STK_CALLBACK_URL=
DARAJA_B2C_SHORTCODE=
DARAJA_INITIATOR_NAME=
DARAJA_SECURITY_CREDENTIAL=
DARAJA_B2C_RESULT_URL=
DARAJA_B2C_TIMEOUT_URL=
